# Copy to .env and fill in your own values. Never commit .env.
PORT=3334
Base_Url=http://localhost:3334

# PostgreSQL connection string
DB_connection_string=postgres://USER:PASSWORD@localhost:5432/DATABASE

# Initial admin account
adminUser=admin
adminEmail=admin@example.com
adminPassword=change-me

# Stripe
stripeSecretKey=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_secret
monthly_productId=
monthly_priceId=
annual_productId=
annual_priceId=
two_year_productId=
two_year_priceId=
one_day_productId=
one_day_priceId=
one_year_upsell_productId=
one_year_upsell_priceId=
monthly_big_pro_membership_productId=
monthly_big_pro_membership_priceId=
annual_big_pro_membership_productId=
annual_big_pro_membership_priceId=

# Mailchimp
MailChimpServerPrefix=us1
MailChimpTransactionalApiKey=your-mailchimp-transactional-key
PERSONAL_PAGE_SUBSCRIBERS_LIST_ID=your-audience-list-id

# Image / file storage
cloudName=your-cloudinary-cloud-name
cloudinaryApiKey=your-cloudinary-api-key
cloudinarySecretKey=your-cloudinary-api-secret
Bucket=your-bucket
BackBlaze_Region=us-west-002
BackBlaze_B2_Key=your-b2-key-id
BackBlaze_App_Key=your-b2-application-key
BackBlaze_Bucket=your-b2-bucket

